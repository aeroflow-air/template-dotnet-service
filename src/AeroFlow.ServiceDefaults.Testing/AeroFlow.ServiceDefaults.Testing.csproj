<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AeroFlow.ServiceDefaults.Testing</RootNamespace>
    <AssemblyName>AeroFlow.ServiceDefaults.Testing</AssemblyName>
    <Description>Log collector and contract assertions for AeroFlow.ServiceDefaults (ADR-0022).</Description>
    <PackageId>AeroFlow.ServiceDefaults.Testing</PackageId>
    <Version>0.1.0</Version>
    <Authors>AeroFlow</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aeroflow-air/template-dotnet-service</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AeroFlow.ServiceDefaults\AeroFlow.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
